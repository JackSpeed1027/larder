# 说明：本文件用于 Linux 部署（bind mount 后权限为 0644）。
# Windows 开发机上 bind mount 会变成 0777，MySQL 会忽略该文件，因此 compose 的 command 参数里已显式设置字符集/时区。
# MySQL 8.4 单机配置（开发/评测用，不是高可用方案）
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'
max_connections = 100
innodb_buffer_pool_size = 256M
innodb_flush_log_at_trx_commit = 1
slow_query_log = 1
long_query_time = 1
log_error_verbosity = 2

[client]
default-character-set = utf8mb4
