# Larder 环境变量模板（复制为 .env 后填写；.env 不入库）
# 命名统一 LARDER_ 前缀；密码请用密码管理器生成，不要复用示例值。

# --- 应用 ---
LARDER_VERSION=0.1.0

# --- 单管理员登录（bcrypt hash 优先；开发期可用明文，启动时现算） ---
LARDER_ADMIN_USERNAME=admin
LARDER_ADMIN_PASSWORD=change-me-admin-password

# --- MySQL 8.4 ---
LARDER_DB_NAME=larder
LARDER_DB_USER=larder
# 生成方式示例：powershell -c "[guid]::NewGuid().ToString('N')"
LARDER_DB_PASSWORD=change-me-db-password
LARDER_DB_ROOT_PASSWORD=change-me-root-password

# --- RabbitMQ 4.3 ---
LARDER_RABBITMQ_USER=larder
LARDER_RABBITMQ_PASSWORD=change-me-mq-password

# --- Meilisearch 1.56 ---
# 至少 16 字节；生产必须换掉
LARDER_MEILI_MASTER_KEY=change-me-meili-master-key

# --- MinIO ---
LARDER_MINIO_ROOT_USER=larder
# MinIO 要求 root 密码至少 8 位；这里只用于初始化，业务侧会另发受限账号
LARDER_MINIO_ROOT_PASSWORD=change-me-minio-root-password

# --- Runner ---
LARDER_RUNNER_JOURNAL_DIR=/var/lib/larder/journal
LARDER_RUNNER_MAX_CONCURRENT_RUNS=2
