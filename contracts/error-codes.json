{
  "version": 1,
  "source": "docs/04-接口与数据契约.md §4 错误码表与接口语义",
  "description": "R1 稳定错误码注册表。Java 公开 API 的 ApiErrorResponse.code 必须取自本表；Runner 错误同样登记在此，新增错误码必须先改这里再改实现。",
  "codes": [
    { "code": "NEED_LOGIN", "httpStatus": 401, "retryableDefault": false, "owner": "api", "description": "未登录或 session 失效，重新登录后重试" },
    { "code": "FORBIDDEN_TARGET", "httpStatus": 403, "retryableDefault": false, "owner": "api", "description": "目标越权/不在授权范围，不得伪装成网络失败" },
    { "code": "NOT_FOUND", "httpStatus": 404, "retryableDefault": false, "owner": "api", "description": "资源不存在或无权可见" },
    { "code": "VALIDATION_FAILED", "httpStatus": 400, "retryableDefault": false, "owner": "api", "description": "请求 schema 校验失败（含未知字段）" },
    { "code": "PAYLOAD_TOO_LARGE", "httpStatus": 413, "retryableDefault": false, "owner": "api", "description": "超过体积/条目上限" },
    { "code": "RATE_LIMITED", "httpStatus": 429, "retryableDefault": true, "owner": "both", "description": "有限退避，尊重 Retry-After 与总 deadline" },
    { "code": "IDEMPOTENCY_CONFLICT", "httpStatus": 409, "retryableDefault": false, "owner": "api", "description": "同幂等键不同请求体" },
    { "code": "DEPENDENCY_UNAVAILABLE", "httpStatus": 503, "retryableDefault": true, "owner": "both", "description": "依赖暂不可用（MQ/搜索/对象存储/模型）" },
    { "code": "INTERNAL_ERROR", "httpStatus": 500, "retryableDefault": false, "owner": "both", "description": "未分类内部错误，不泄露堆栈" },
    { "code": "FETCH_TIMEOUT", "httpStatus": 504, "retryableDefault": true, "owner": "runner", "description": "抓取超时，可在预算内退避重试" },
    { "code": "EXTRACT_EMPTY", "httpStatus": 422, "retryableDefault": false, "owner": "runner", "description": "抽取结果为空，保留原输入，不编造正文" },
    { "code": "OCR_UNSUPPORTED", "httpStatus": 415, "retryableDefault": false, "owner": "runner", "description": "扫描件/格式暂不支持 OCR" },
    { "code": "RUN_PAYLOAD_CONFLICT", "httpStatus": 409, "retryableDefault": false, "owner": "runner", "description": "同 runId 不同请求体" },
    { "code": "STALE_WRITE", "httpStatus": 409, "retryableDefault": false, "owner": "api", "description": "expectedVersion 落后，刷新后重试" },
    { "code": "APPROVAL_STALE", "httpStatus": 409, "retryableDefault": false, "owner": "api", "description": "审批绑定的资源版本已变化，需要重新审批" },
    { "code": "LEASE_LOST", "httpStatus": 409, "retryableDefault": false, "owner": "api", "description": "worker lease 失效，旧提交被拒绝" },
    { "code": "PROCESSING_SUPERSEDED", "httpStatus": 409, "retryableDefault": false, "owner": "api", "description": "processingEpoch 已推进，旧结果不得发布" },
    { "code": "INDEX_TASK_FAILED", "httpStatus": 502, "retryableDefault": true, "owner": "api", "description": "索引任务失败，旧 generation 继续服务" },
    { "code": "INDEX_VALIDATION_FAILED", "httpStatus": 500, "retryableDefault": false, "owner": "api", "description": "索引校验未通过，不切换发布指针" },
    { "code": "UNKNOWN_PROVIDER_RESULT", "httpStatus": 409, "retryableDefault": false, "owner": "runner", "description": "供应商结果未知，需人工决定是否重试计费" },
    { "code": "INVALID_CITATION", "httpStatus": 422, "retryableDefault": false, "owner": "runner", "description": "引用无法定位或与结论不符" },
    { "code": "INVALID_MODEL_OUTPUT", "httpStatus": 422, "retryableDefault": false, "owner": "runner", "description": "结构化输出不合法，最多一次预算内修复" },
    { "code": "BUDGET_EXCEEDED", "httpStatus": 429, "retryableDefault": false, "owner": "both", "description": "超出本次 run 预算" },
    { "code": "TOOL_LIMIT_EXCEEDED", "httpStatus": 429, "retryableDefault": false, "owner": "runner", "description": "工具调用次数超限" },
    { "code": "SSRF_BLOCKED", "httpStatus": 400, "retryableDefault": false, "owner": "runner", "description": "目标地址越界（重定向/DNS/IPv6）" },
    { "code": "JOURNAL_CORRUPT", "httpStatus": 500, "retryableDefault": false, "owner": "runner", "description": "journal 中间损坏，停 run 并保留现场" },
    { "code": "CORRUPT_ARTIFACT", "httpStatus": 500, "retryableDefault": false, "owner": "runner", "description": "产物 hash/大小校验失败" }
  ]
}
