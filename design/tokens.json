{
  "version": "design-v1",
  "status": "SPECIFICATION_NOT_PRODUCT",
  "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Microsoft YaHei, sans-serif",
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "control": 6,
    "card": 8,
    "dialog": 12
  },
  "type": {
    "ui": {
      "size": 14,
      "lineHeight": 22
    },
    "secondary": {
      "size": 12,
      "lineHeight": 18
    },
    "pageTitle": {
      "size": 24,
      "lineHeight": 32,
      "weight": 600
    },
    "reading": {
      "size": 18,
      "lineHeight": 1.8,
      "maxWidth": 720
    }
  },
  "layout": {
    "sidebar": 216,
    "rail": 64,
    "topbar": 56,
    "pagePaddingDesktop": 24,
    "pagePaddingMobile": 16,
    "contentMax": 1440,
    "readerToc": 200,
    "readerEvidence": 320,
    "drawer": 360
  },
  "breakpoints": {
    "mobileMaxExclusive": 768,
    "desktopMin": 1280,
    "readerTocMin": 1440
  },
  "motion": {
    "colorMs": 120,
    "visibilityMs": 160,
    "flipMs": 280,
    "flipPerspective": 1200,
    "reducedMotion": "instant-no-transform"
  },
  "themes": {
    "light": {
      "background": "#F7F8FA",
      "surface": "#FFFFFF",
      "text": "#182230",
      "muted": "#526173",
      "border": "#D8DEE8",
      "primary": "#1D4ED8",
      "onPrimary": "#FFFFFF",
      "danger": "#B42318",
      "dangerBg": "#FEF3F2",
      "success": "#166534",
      "successBg": "#F0FDF4",
      "warning": "#854D0E",
      "warningBg": "#FEFCE8"
    },
    "dark": {
      "background": "#101722",
      "surface": "#172131",
      "text": "#E9EEF5",
      "muted": "#AAB8CA",
      "border": "#3B4A60",
      "primary": "#8FB5FF",
      "onPrimary": "#101722",
      "danger": "#FFB4AB",
      "dangerBg": "#3A1D24",
      "success": "#91D5A4",
      "successBg": "#143025",
      "warning": "#F0CF83",
      "warningBg": "#342B17"
